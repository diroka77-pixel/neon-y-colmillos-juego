; Archivo de configuración del proyecto.
; Conviene editarlo desde Godot para cambios futuros.

config_version=5

[application]

config/name="Neón y Colmillos"
run/main_scene="res://scenes/inicio.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/placeholder/icon.svg"

[autoload]

InputSetup="*res://scripts/input_setup.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
environment/defaults/default_clear_color=Color(0.012, 0.016, 0.027, 1)

[physics]

common/enable_pause_aware_picking=true

